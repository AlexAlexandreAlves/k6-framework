{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "resolveJsonModule": true,
        "target": "ES2020",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2020"
        ],
        "types": [],
        "rootDir": "./src"
    },
    "include": [
        "src/**/*.js",
        "src/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts"
    ]
}